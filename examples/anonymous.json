{
  "version": 2,
  "providers": {
    "tavily": {
      "enabled": true,
      "connection": { "transport": "stdio", "command": "npx", "args": ["-y", "tavily-mcp@0.2.22"], "env": {} },
      "search": { "name": "tavily_search", "arguments": { "query": "$query", "max_results": "$maxResults", "search_depth": "basic" }, "minResults": 5 }
    },
    "exa": {
      "enabled": true,
      "connection": { "transport": "http", "url": "https://mcp.exa.ai/mcp", "headers": {} },
      "search": { "name": "web_search_exa", "arguments": { "query": "$query", "objective": "$query", "numResults": "$maxResults" } }
    },
    "jina": {
      "enabled": true,
      "connection": { "transport": "http", "url": "https://mcp.jina.ai/v1", "headers": {} },
      "read": { "name": "read_url", "arguments": { "url": "$url", "question": "$focus", "topk": 3, "chunk_size": 250 } }
    },
    "firecrawl": {
      "enabled": true,
      "connection": { "transport": "http", "url": "https://mcp.firecrawl.dev/v2/mcp", "headers": {} },
      "read": { "name": "firecrawl_scrape", "arguments": { "url": "$url", "formats": ["markdown"], "onlyMainContent": true, "objective": "Read the supplied public webpage as Markdown." } }
    }
  },
  "routes": {
    "defaultIntent": "general",
    "search": "tavily",
    "read": "jina",
    "intents": { "general": "tavily", "research": "tavily", "semantic": "exa" },
    "searchFallback": [],
    "readFallback": []
  },
  "timeoutMs": 60000,
  "providerTimeoutMs": 20000,
  "maxOutputChars": 16000
}
