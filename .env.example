# Documentation only. Siftpath does not auto-load workspace .env files.
# Prefer siftpath setup or your shell/OS secret manager.
EXA_API_KEY=
PARALLEL_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override of the private user configuration path:
# SIFTPATH_CONFIG=/absolute/path/to/config.json
# For explicitly enabled HTTP serving only:
# SIFTPATH_SERVER_TOKEN=<generate-a-random-24-or-more-character-token>
# SIFTPATH_ALLOWED_HOSTS=evidence.example.org
# Optional browser origin allowlist for HTTP serving:
# SIFTPATH_ALLOWED_ORIGINS=https://your-client.example.org
# Explicit opt-in for potentially billable provider tests:
# SIFTPATH_LIVE=1
# SMARTSEARCH_* names remain fallback aliases; prefer SIFTPATH_* for new setups.
